# Supabase project (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional: GIPHY API key (https://developers.giphy.com) for GIF search in chat.
# Without it, players can still paste GIF links and use the built-in troll stickers.
NEXT_PUBLIC_GIPHY_API_KEY=

# Optional: public URL of your Vercel deployment. Used for invite links from the native app.
NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app
